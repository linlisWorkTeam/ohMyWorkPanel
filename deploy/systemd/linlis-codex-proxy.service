[Unit]
Description=Linlis Codex DeepSeek Responses shim (:18888)
After=network.target
Documentation=file:///AI/LinlisWorkPanel/scripts/codex-deepseek-proxy.cjs

[Service]
Type=simple
User=root
WorkingDirectory=/AI/LinlisWorkPanel
ExecStart=/usr/bin/node /AI/LinlisWorkPanel/scripts/codex-deepseek-proxy.cjs
Restart=always
RestartSec=2
Environment=NODE_ENV=production
# Prefer auth.json; shell OPENAI_API_KEY also works if present
StandardOutput=append:/tmp/codex-deepseek-proxy.log
StandardError=append:/tmp/codex-deepseek-proxy.log

[Install]
WantedBy=multi-user.target
